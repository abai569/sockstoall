{
  "name": "sockstoall",
  "version": "1.2.0",
  "description": "多协议代理节点管理 + SOCKS 转发面板",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.server.json",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:release": "vite build && npm run build:server",
    "start": "node dist/server.mjs",
    "install:all": "tsx scripts/install.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@hono/node-server": "^1.8.0",
    "antd": "^5.15.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "hono": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0"
  }
}
